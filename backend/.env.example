# Configuration de l'environnement backend CHATILE
PORT=3000
NODE_ENV=development

# Clé API Mistral AI (OBLIGATOIRE - Garder secrète dans .env)
MISTRAL_API_KEY=votre_cle_api_mistral_ici

# Configuration Firebase & Google Play API
FIREBASE_PROJECT_ID=chatile
GOOGLE_PLAY_PACKAGE_NAME=com.chatile
GOOGLE_OAUTH_CLIENT_ID=votre_client_id_google.apps.googleusercontent.com
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Remplacez par le contenu JSON brut de votre compte de service Firebase si hébergé sur PaaS (Render, Heroku...)
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}

# Configuration URL Publique (ex: https://chatile.onrender.com)
PUBLIC_BASE_URL=http://10.0.2.2:3000
ADMIN_EMAIL=votre_email_admin@example.com
